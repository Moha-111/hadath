{
  "name": "hadath",
  "version": "0.1.0",
  "private": true,
  "description": "HADATH | حدث — open-source research prototype for unified emergency preparedness, operations and recovery (synthetic data only).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "scenario": "tsx scripts/run-scenario.ts",
    "licenses": "node scripts/third-party-licenses.mjs > THIRD_PARTY_LICENSES.md"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
